<?xml version="1.0" encoding="utf-8"?>
<!-- Riptide notification icon — "Rising Currents" (white on transparent).
     Same wave mark as app icon, optimized for notification tray. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Top current -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,11.5 C7,8.5 9,9.5 12,11 C15,12.5 16,7 21,6" />

    <!-- Middle current — same wave, centered between top and bottom -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,14 C7,11 9,12 12,13.5 C15,15 16,9.5 21,8.5" />

    <!-- Bottom current -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M3,16.5 C7,13.5 9,14.5 12,16 C15,17.5 16,12 21,11" />
</vector>
