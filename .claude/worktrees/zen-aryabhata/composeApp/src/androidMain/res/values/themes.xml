<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Splash screen theme (core-splashscreen compat, works from API 23+) -->
    <style name="Theme.Riptide.Splash" parent="Theme.SplashScreen">
        <!-- Background: vibrant ocean blue matching ic_launcher_background -->
        <item name="windowSplashScreenBackground">#1565C0</item>
        <!-- Animated icon: adaptive icon (shows the wave foreground) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <!-- Post-splash theme: material light with no action bar for Compose -->
        <item name="postSplashScreenTheme">@android:style/Theme.Material.Light.NoActionBar</item>
    </style>

</resources>
