<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Secure-by-default: no cleartext traffic permitted in any build.
         Debug builds override this via composeApp/src/androidDebug/res/xml/network_security_config.xml. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
