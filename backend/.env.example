# ============================================================
# Riptide Backend — Environment Variables TEMPLATE
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# .env esta en .gitignore — este .example SI se versiona.
# ============================================================

# --- PostgreSQL ---
DATABASE_URL=jdbc:postgresql://localhost:5432/riptide
DATABASE_USER=riptide
DATABASE_PASSWORD=your_password_here

# --- JWT ---
# Minimo 32 caracteres. Genera uno aleatorio para produccion.
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# --- Google OAuth ---
# Web Application Client ID de Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
